# Supabase Configuration
# Obtain these values from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only key (Never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WhatsApp Business / Coordination Number (format: country code without +, e.g. 8801700000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801645441584

# Brevo API Key (REST API Key from Brevo > SMTP & API > API Keys)
BREVO_API_KEY=your-brevo-api-key-here


